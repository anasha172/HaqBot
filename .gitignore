# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments --------------------------------------------------
.venv/
venv/
env/

# --- Test / coverage artefacts ------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- HaqBot local data — NEVER commit user data or model binaries -----------
data/local_user.db
data/local_user.db-journal
data/local_user.db-wal
data/local_user.db-shm
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Raw legal PDFs are large; add deliberately with `git add -f data/raw/<file>`.
data/raw/*
!data/raw/.gitkeep

# --- OS / editor ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
